{
  "appId": "com.flovex.desktop",
  "productName": "flovex",
  "directories": {
    "output": "dist-electron",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "build/**/*",
    "package.json",
    "firebase-applet-config.json"
  ],
  "extraMetadata": {
    "name": "flovex",
    "version": "1.0.0",
    "description": "Instant ephemeral file sharing powered by Firestore",
    "author": "flovex",
    "main": "electron/main.cjs"
  },
  "win": {
    "icon": "build/icon.ico",
    "signExecutable": false,
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "portable": {
    "artifactName": "${productName}-${version}-portable.${ext}"
  },
  "nsis": {
    "artifactName": "${productName}-${version}-setup.${ext}",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
